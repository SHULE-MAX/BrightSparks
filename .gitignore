node_modules/

# Root-only build helpers for the image scripts. These patterns are anchored
# with a leading slash on purpose — unanchored they would also swallow
# admin/package.json, which Railway needs in order to build the dashboard.
/package.json
/package-lock.json
convert-webp.mjs

# Copies of files that already live in this repository, laid out the way the
# server wants them. Written fresh by "package-upload.mjs --stage" every time.
/_deploy/

# The by-hand upload bundle, written by "node package-upload.mjs". It holds
# nothing that is not already here in its ordinary form, and committing it only
# added a rewritten copy of the site to every build. Run the script on the day
# you need it — that is also the only way to be sure it is current.
/news-upload.zip

# Admin dashboard
admin/dist/
admin/.env
admin/.env.local

# The cPanel API token, for running the deploy from this machine by hand.
# On the server side it is a GitHub Actions secret; this file is only so the
# smoke test and a manual deploy can authenticate. It is a live credential
# with the run of the whole cPanel account — never commit it, never paste it
# into a chat or an issue. If it leaks, revoke it in cPanel → Security →
# Manage API Tokens and issue a new one; nothing here needs changing.
/.cpanel-token
