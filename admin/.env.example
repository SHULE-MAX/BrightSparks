# ════════════════════════════════════════════════════════════════════════════
#  Settings for the Bright Sparks admin dashboard
#
#  FOR LOCAL USE: copy this file to ".env" in this same folder and fill in the
#  values. Find them at supabase.com → your project → Settings → API.
#
#  ON RAILWAY: do NOT upload this file. Enter the same names and values under
#  your service → Variables instead.
# ════════════════════════════════════════════════════════════════════════════

# Your project's URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# The "anon public" key — NOT the "service_role" key.
# The service_role key bypasses all security and must never leave your computer.
SUPABASE_ANON_KEY=

# The public website, used by the "View the website" link in the dashboard.
SITE_URL=https://brightsparksjunior.ac.ug
